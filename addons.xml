<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>

<addon id="repository.zogai" name="Zogai Repository" version="1.0.0" provider-name="Zogai">
  <extension point="xbmc.addon.repository" name="Zogai Repository">
    <info compressed="false">https://zogai.github.io/zogai/addons.xml</info>
    <checksum>https://zogai.github.io/zogai/addons.xml.md5</checksum>
    <datadir zip="true">https://zogai.github.io/zogai/</datadir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Zogai Kodi Build Repository</summary>
    <description>Zogai Kodi Build repository.</description>
    <platform>all</platform>
  </extension>
</addon>

<addon id="plugin.program.zogaiwizard" name="Zogai Wizard" version="1.0.0" provider-name="Zogai">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Zogai Wizard</summary>
    <description>Download Zogai Kodi Build.</description>
    <platform>all</platform>
  </extension>
</addon>

</addons>
